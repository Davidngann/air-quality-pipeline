{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowGlueReadRawBucket",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:ListBucket"
            ],
            "Resource": [
                "arn:aws:s3:::aq-raw-david-853407830340",
                "arn:aws:s3:::aq-raw-david-853407830340/*"
            ]
        },
        {
            "Sid":"AllowGlueReadStagedBucket",
            "Effect": "Allow",
            "Action": [
                "s3:PutObject",
                "s3:DeleteObject"
            ],
            "Resource": [
                "arn:aws:s3:::aq-staged-david-853407830340/*"
            ]
        }
    ]
}